DB_PORT=5432
DB_NAME=labdb
DB_USER=labapp
DB_PASSWORD=

# Opciones configuradas:
# ----------------------
# DB_HOST -> IP de vm-postgres; localhost no vale porque PostgreSQL está en otra VM
# DB_PORT -> puerto de PostgreSQL
# DB_NAME y DB_USER -> base y usuario de la TAREA 3
# DB_PASSWORD -> vacía en la plantilla; solo va en el .env de la VM, sin comillas
